{
  "name": "obsidian-server",
  "version": "1.0.0",
  "private": true,
  "description": "Accounts API for Obsidian: sign-up, sign-in and saved profiles, stored in MongoDB.",
  "author": "Atharva Lakhe (https://github.com/AtharvaLakhe)",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "npm --prefix ../client install && npm --prefix ../client run build",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^7.0.2"
  }
}
